{
  "name": "rc_customer",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "start": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^react-redux$": "<rootDir>/node_modules/react-redux/dist/cjs/index.js",
      "^immer$": "<rootDir>/node_modules/immer/dist/cjs/index.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/dist/"
    ],
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ],
    "testTimeout": 20000
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.2.3",
    "@expo/config": "^58.0.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@reduxjs/toolkit": "^2.8.2",
    "axios": "^1.10.0",
    "expo": "^58.0.19",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-modules-core": "~58.0.26",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-app-intro-slider": "^4.0.4",
    "react-native-bouncy-checkbox": "^4.1.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "axios-mock-adapter": "^2.1.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
